# E2E: compila el instalador y lo ejecuta en un Ubuntu limpio (no Omarchy).
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /pacman-installer ./cmd/installer

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive TERM=xterm-256color
RUN apt-get update && apt-get install -y --no-install-recommends sudo ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash testuser \
    && echo "testuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/testuser
COPY --chown=testuser . /home/testuser/dotfiles
COPY --from=build /pacman-installer /home/testuser/dotfiles/bin/installer
USER testuser
WORKDIR /home/testuser
ENV HOME=/home/testuser
CMD ["/home/testuser/dotfiles/e2e/e2e_test.sh"]
